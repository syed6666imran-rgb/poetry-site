# MongoDB
MONGODB_URI=mongodb://localhost:27017/letters-to-my-love
# OR MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/letters-to-my-love

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Admin credentials (used for initial seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Private letter secret key
PRIVATE_LETTER_KEY=mylove

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
